# LELUASA - Multi-Service Local Environment Configuration

# -----------------------------------------------------------------------------
# CLIENT CONFIGURATION (VITE)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_MAP_DEFAULT_LAT=-7.2575
VITE_MAP_DEFAULT_LNG=112.7521
VITE_MAP_DEFAULT_ZOOM=14

# -----------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (NODE.JS / EXPRESS)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=8000
ORS_API_KEY=
JWT_SECRET=leluasa_hackathon_secret_key_change_in_production
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SUPABASE_URL=
# Server-side only. Never expose this key through a VITE_ variable or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# AI SERVICE CONFIGURATION (PYTHON / FASTAPI)
# -----------------------------------------------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8000
ENVIRONMENT=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
YOLO_MODEL_PATH=app/models/weights/yolov8n.pt
CONFIDENCE_THRESHOLD=0.30
IOU_THRESHOLD=0.45
